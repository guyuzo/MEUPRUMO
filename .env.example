# Copie para .env.local e preencha com os dados do seu projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Usado só pela CLI para aplicar migrations (npm run db:push). Nunca exposto ao front.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opcional, só para `npm run test:db`. Ignora a RLS: NUNCA use com prefixo VITE_ nem versione.
SUPABASE_SECRET_KEY=
